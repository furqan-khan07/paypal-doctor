# Copy to .env and fill in. Sandbox credentials only - never live ones.
# developer.paypal.com > Apps & Credentials > (Sandbox) > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Optional: an existing sandbox webhook id. If empty, the doctor creates one for probes.
PAYPAL_WEBHOOK_ID=
